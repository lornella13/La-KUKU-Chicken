# ---------------------------------------------------------------------------
# La Kuku Chicken — environment configuration
#
# Copy to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# `.env.local` and every other `.env*` file is git-ignored. Never commit real
# values. Never put a Supabase SERVICE-ROLE / secret key in here or anywhere
# else that reaches the browser -- this is a public Vite build, so every
# VITE_* value is compiled into client JavaScript and is visible to anyone.
#
# The only value the browser is allowed to hold is the PUBLISHABLE (anon) key.
# Database access is protected by Row Level Security, not by hiding the key.
# ---------------------------------------------------------------------------

# Your Supabase project URL. From Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://muopqgcwsyuwiakuiffm.supabase.co
# Publishable / anon key. Safe to expose to the browser BY DESIGN, because RLS
# is what actually protects the data. Find it in the same API settings page.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_U5Uq6NYpdPrcC8e7MAfMKA_qEXFQX_d
